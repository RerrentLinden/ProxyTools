# 旧安装地址的兼容入口，由 tests/sync-legacy-checkins.js 从正式模块生成。
#!name=DeepFlood自动签到
#!desc=每日定时签到。使用已登录浏览器打开 DeepFlood「个人账号设置」获取 Cookie；适用于 Surge Mac。
#!category=签到任务
#!author=RerrentLinden
#!arguments=定时签到:0 9 * * *,禁用脚本:DeepFlood[Token],禁用MITM:hostname
#!arguments-desc=定时签到：每天 09:00 签到，可修改为其他 Cron 表达式。\n禁用脚本：捕获脚本名称，填 # 可关闭捕获。\n禁用MITM：保留 hostname；填 # 可停止本模块追加解密域名。\n凭据仅保存在 Surge，不写入日志。

[Script]
DeepFlood签到 = type=cron,cronexp="{{{定时签到}}}",timeout=180,script-path=https://raw.githubusercontent.com/RerrentLinden/ProxyTools/main/surge-modules/scripts/seek-checkin.js,argument="site=deepflood"
{{{禁用脚本}}} = type=http-response,pattern=^https:\/\/www\.deepflood\.com\/api\/account\/getInfo\/[1-9]\d*\?,requires-body=true,max-size=262144,timeout=15,script-path=https://raw.githubusercontent.com/RerrentLinden/ProxyTools/main/surge-modules/scripts/seek-checkin.js,argument="site=deepflood"

[MITM]
{{{禁用MITM}}} = %APPEND% www.deepflood.com
