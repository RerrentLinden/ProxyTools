#!name=V2EX 自动签到
#!desc=每日领取 V2EX 登录奖励。登录后打开 https://www.v2ex.com/mission/daily 捕获 Cookie；随后由 Surge 独立执行签到并核对服务器状态。
#!author=RerrentLinden
#!category=签到任务
#!system=mac
#!arguments=cron:5 0 * * *
#!arguments-desc=cron：每日执行时间，默认每天 00:05。Mac 需要保持唤醒且 Surge 正在运行。首次使用须启用 MITM 并信任现有 Surge 证书，然后打开已登录的日常任务页。

[Script]
V2EX[凭据] = type=http-request,pattern=^https://(?:www\.)?v2ex\.com/(?:mission/daily|settings)/?(?:\?|$),script-path=https://raw.githubusercontent.com/RerrentLinden/ProxyTools/main/surge-modules/scripts/v2ex.js,timeout=5
V2EX[签到] = type=cron,cronexp="{{{cron}}}",script-path=https://raw.githubusercontent.com/RerrentLinden/ProxyTools/main/surge-modules/scripts/v2ex.js,timeout=50

[MITM]
hostname = %APPEND% www.v2ex.com, v2ex.com
