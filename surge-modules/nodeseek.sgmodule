#!name=NodeSeek自动签到
#!desc=每日定时签到。使用已登录浏览器打开 NodeSeek「个人账号设置」获取 Cookie；适用于 Surge Mac。
#!category=签到任务
#!author=RerrentLinden
#!arguments=cron:0 9 * * *,mode:fixed,capture:NodeSeek获取Cookie,mitm:hostname
#!arguments-desc=cron：每天 09:00 签到，可修改为其他 Cron 表达式。\nmode：fixed 固定奖励；random 随机奖励。\ncapture：捕获脚本名称，填 # 可关闭捕获。\nmitm：保留 hostname；填 # 可停止本模块追加解密域名。\n凭据仅保存在 Surge，不写入日志。

[Script]
NodeSeek签到 = type=cron,cronexp="{{{cron}}}",timeout=180,script-path=https://raw.githubusercontent.com/RerrentLinden/ProxyTools/main/surge-modules/scripts/seek-checkin.js,argument="site=nodeseek&mode={{{mode}}}"
{{{capture}}} = type=http-response,pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/[1-9]\d*\?,requires-body=true,max-size=262144,timeout=15,script-path=https://raw.githubusercontent.com/RerrentLinden/ProxyTools/main/surge-modules/scripts/seek-checkin.js,argument="site=nodeseek"

[MITM]
{{{mitm}}} = %APPEND% www.nodeseek.com
